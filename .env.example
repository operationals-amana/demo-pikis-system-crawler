# --- database --------------------------------------------------------------
# Railway: set to ${{Postgres.DATABASE_URL}}. The Postgres service MUST ship
# pgvector -- verify with: SELECT * FROM pg_available_extensions WHERE name='vector';
# db/migrations/0001 fails loudly at migrate time if it is absent.
DATABASE_URL=postgresql://pguser:pgpass123@localhost:5433/pikis
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10

# --- app -------------------------------------------------------------------
PORT=8000
LOG_LEVEL=INFO
# Exact Vercel origins, comma separated. Bearer tokens are used rather than cookies,
# so allow_credentials stays false and no wildcard exemption is needed.
CORS_ORIGINS=http://localhost:3000

# --- auth ------------------------------------------------------------------
# REQUIRED. Generate with: openssl rand -hex 32
# The service refuses to mint tokens without it rather than signing with "".
JWT_SECRET=
ACCESS_TOKEN_MINUTES=720
REFRESH_TOKEN_DAYS=30
ALLOW_SELF_REGISTER=false

# --- llm -------------------------------------------------------------------
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5
LLM_MAX_TOKENS=1600
CHAT_TIMEOUT_SECONDS=90
# Vercel Fluid functions cap at 300s on Pro and 60s on Hobby. A chat that can run to
# 300s is one that will eventually return a truncated stream, so keep this below the
# platform ceiling -- the assistant message is persisted either way, which is what
# lets a truncated client recover via GET /api/sessions/{id}.

# --- embeddings ------------------------------------------------------------
# 384-dim. Changing this needs an ALTER TABLE on chunks.embedding AND a full re-embed
# (scripts/reembed.py) -- the column width and the model must move together.
EMBEDDING_MODEL=intfloat/multilingual-e5-small
EMBEDDING_DIM=384
# Set BEFORE torch is imported. On a shared-CPU container torch otherwise grabs every
# visible (throttled) core and oversubscription makes it SLOWER, not faster.
EMBED_THREADS=2
# Defer loading the model until first use -- useful with uvicorn --reload locally.
EMBEDDING_LAZY=false

# --- retrieval -------------------------------------------------------------
RETRIEVAL_CANDIDATES=60
TOP_K_CONTEXT=8
MAX_CHUNKS_PER_ARTICLE=2
RERANK_MODE=lexical
# Gate 1: the pre-LLM no-evidence threshold. Keyed on ABSOLUTE cosine because RRF is
# rank-based and cannot express "nothing here is relevant". Measured separation on
# this corpus: on-topic 0.86-0.91, off-topic 0.77-0.84. Set conservatively -- refusing
# a real question is worse than falling through to the prompt-level gate.
MIN_SEMANTIC_SIMILARITY=0.82
MIN_EVIDENCE_CHUNKS=2
MIN_EVIDENCE_SCORE=0.018
# Cross-lingual bridging. DIRECTIONAL on purpose: id->en lifts Indonesian recall@5
# from 0.00 to 0.88, while en->id measurably degrades English results by dragging
# them toward the weaker Indonesian half of the corpus.
ENABLE_QUERY_TRANSLATION=true
TRANSLATE_FROM_LANGUAGES=id

# --- harvest ---------------------------------------------------------------
IJE_OAI_URL=https://ije-pyc.org/IJE/oai
PYC_WP_URL=https://purnomoyusgiantorocenter.org/wp-json/wp/v2

# --- crawl schedule --------------------------------------------------------
# Railway: prefer the platform cron on the ingest service -- '0 18 * * *' UTC is
# 01:00 WIB daily. The worker role (docker-entrypoint.sh worker) is the fallback
# scheduler for platforms without a cron; it crawls at CRAWL_HOUR_LOCAL in
# CRAWL_TIMEZONE once a day.
CRAWL_TIMEZONE=Asia/Jakarta
CRAWL_HOUR_LOCAL=1
